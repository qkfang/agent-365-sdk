AZURE_OPENAI_ENDPOINT=https://<account>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=<model-deployment>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<toolbox>/mcp?api-version=v1

# Application (client) ID of the per-instance Entra Agent Identity, not the blueprint.
AGENT_IDENTITY_CLIENT_ID=<agent-identity-app-id>
ENTRA_TENANT_ID=<agent-identity-home-tenant-id>
AGENT_IDENTITY_BLUEPRINT_CLIENT_ID=<blueprint-app-id>
# Development only. Use workload federation or a certificate in production.
AGENT_IDENTITY_BLUEPRINT_CLIENT_SECRET=<blueprint-client-secret>
# Production alternative: path to the SaaS workload's projected OIDC assertion.
# AGENT_IDENTITY_BLUEPRINT_ASSERTION_FILE=<path-to-oidc-assertion>

# Dedicated app credential used only by provision_agent_identity.py. Grant the
# required Microsoft Graph application permissions and tenant admin consent.
AGENT_ID_SETUP_CLIENT_ID=<setup-application-id>
AGENT_ID_SETUP_CLIENT_SECRET=<setup-application-secret>
AGENT_ID_SETUP_SPONSOR_USER_ID=<sponsor-user-object-id>