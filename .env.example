AZURE_OPENAI_ENDPOINT=https://<account>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=<model-deployment>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<toolbox>/mcp?api-version=v1

# Application (client) ID of the per-instance Entra Agent Identity, not the blueprint.
AGENT_IDENTITY_CLIENT_ID=<agent-identity-app-id>
AGENTID_SIDECAR_URL=http://localhost:5000